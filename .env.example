# Create a private .env file from this template.
# Never commit your real .env file to GitHub.

# Where the web UI listens. 127.0.0.1 = only this computer (recommended).
# Use 0.0.0.0 only if you understand the UI has no login.
HOST=127.0.0.1
PORT=8000

# Proxy for all yt-dlp traffic. None = no proxy.
#   10808                       -> socks5 on 127.0.0.1:10808 (v2ray/v2rayN default SOCKS port)
#   127.0.0.1:10808             -> same, socks5
#   http://127.0.0.1:10809      -> HTTP proxy (v2rayN default HTTP port)
#   socks5://user:pass@host:1080 -> any full proxy URL
PROXY=None

# Easiest way past YouTube's "Sign in to confirm you're not a bot":
# read cookies directly from a browser where you're logged in to YouTube.
# One of: firefox, chrome, chromium, edge, brave, opera, vivaldi, safari
COOKIES_FROM_BROWSER=

# Optional: absolute path to your own exported cookies file.
# Keep cookies private. Leave blank if not needed.
COOKIE_FILE=

# 0 means no configured playlist cap. Set e.g. 100 to cap playlists.
MAX_PLAYLIST_ITEMS=0

# Starting download folder (the Settings button in the page can change it).
# Files are saved in CHANNEL/SECTION/ inside it.
DOWNLOAD_DIR=downloads
# How long a finished job stays in the list on the page (files are never deleted).
JOB_TTL_MINUTES=60
# How many download jobs may run at once.
MAX_CONCURRENT_JOBS=1

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
